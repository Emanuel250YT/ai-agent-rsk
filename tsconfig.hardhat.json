{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./hardhat-compiled"
  },
  "include": ["hardhat.config.ts", "scripts/**/*.ts", "contracts/**/*.ts"]
}
